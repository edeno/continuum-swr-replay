# Normalize line endings of text files to LF in the repository.
* text=auto

# Always check out Python, the lockfile and LaTeX with LF endings, so a
# Windows checkout (core.autocrlf) matches every other one byte for byte.
*.py text eol=lf
uv.lock text eol=lf
*.tex text eol=lf
*.bib text eol=lf

# A spreadsheet export: its rows end in CRLF and its quoted cells hold LF line
# breaks. Store it byte for byte.
docs/design/replay_detection_comparison/literature_detection_parameters.csv -text
