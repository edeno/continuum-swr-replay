  "usage_guidelines": {
    "max_colors_per_slide": 3,
    "recommended_primary": "wong",
    "for_emphasis": ["#E69F00", "#D55E00", "#F0E442"],
    "for_comparison": ["#E69F00", "#56B4E9", "#009E73"],
    "avoid_combinations": [
      {
        "colors": ["#009E73", "#D55E00"],
        "reason": "Red-green combination problematic for colorblind viewers"
      },
      {
        "colors": ["#F0E442", "#FFFFFF"],
        "reason": "Insufficient contrast on light backgrounds"
      }
    ],
    "testing": {
      "tools": [
        "ColorOracle (free colorblind simulator)",
        "Coblis (web-based colorblind simulator)",
        "WebAIM Contrast Checker (WCAG compliance)"
      ],
      "process": "Always test palette with colorblind simulator before finalizing presentation"
    }
  },
  "wcag_compliance": {
    "normal_text": {
      "min_ratio": 4.5,
      "description": "For text <18pt or <14pt bold"
    },
    "large_text": {
      "min_ratio": 3.0,
      "description": "For text ≥18pt or ≥14pt bold"
    },
    "compliant_combinations": [
